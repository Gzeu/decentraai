# DecentraAI — systemd environment for a PUBLIC VPS node (slow-CPU, no GPU).
#
# These overrides live in the unit (or better: an override file):
#   sudo systemctl edit decentraai-node
# and must be re-applied after a reinstall — that is why this example exists.
#
# Why 1800s: prefill on CPU for large agentic prompts is minutes of silence
# (~11.5k tokens at ~20 tok/s ≈ 8.5 min before the first byte). The shared
# inference budget drives ALL layers from one value since commit 7e849a9:
# backend HTTP idle-read, P2P request/response and remote route timeouts.
# A hung engine still releases its slot at the idle threshold; a slow but
# healthy prefill is allowed to finish.
#
# NOTE: keep exactly ONE Environment line per variable. The live VPS unit
# shipped with the same var declared twice (harmless — last wins — but it
# invites drift).

[Service]
Environment=DECENTRAAI_BACKEND_TIMEOUT_SECS=1800
# llama-server location + libs when installed outside cargo home:
#Environment=DECENTRAAI_LLAMA_SERVER=/home/decentraai/llama-wrapper.sh
#Environment=LD_LIBRARY_PATH=/home/decentraai/llama.cpp/build/bin

# Apply:
#   sudo cp deploy/decentraai-vps.env.example /etc/systemd/system/decentraai-node.service.d/10-vps-env.conf
#   sudo systemctl daemon-reload && sudo systemctl restart decentraai-node
# Verify:
#   systemctl show decentraai-node -p Environment | tr ' ' '\n' | grep DECENTRAAI
